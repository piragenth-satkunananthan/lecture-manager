{
  "name": "student-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "pilot:compare": "npm run build && node dist/scripts/model-comparison-pilot.js",
    "pilot:nvidia": "npm run build && node dist/scripts/nvidia-comparison-pilot.js",
    "pilot:whatsapp": "npm run build && node --env-file-if-exists=.env dist/scripts/whatsapp-pilot.js",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "intake:local": "npm run build && node --env-file-if-exists=.env dist/scripts/intake-local.js",
    "backup": "npm run build && node --env-file-if-exists=.env dist/scripts/backup.js",
    "restore": "npm run build && node --env-file-if-exists=.env dist/scripts/restore.js",
    "whatsapp:groups": "npm run build && node --env-file-if-exists=.env dist/scripts/whatsapp-list-groups.js",
    "pilot:report": "npm run build && node --env-file-if-exists=.env dist/scripts/pilot-report.js",
    "whatsapp:who": "npm run build && node --env-file-if-exists=.env dist/scripts/whatsapp-who.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@fastify/secure-session": "^8.4.2",
    "@fastify/static": "^10.1.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^8.0.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "nodemailer": "^10.4.0",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.7"
  }
}
